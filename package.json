{
  "name": "deso-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "npm run validate:data && vite --host 0.0.0.0",
    "validate:data": "node scripts/validate-data.mjs",
    "test": "node --experimental-strip-types --test --test-isolation=none tests/*.test.ts",
    "build": "npm run validate:data && tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": { "react": "^19.2.0", "react-dom": "^19.2.0", "recharts": "^3.3.0" },
  "devDependencies": { "@types/node": "^24.0.0", "@types/react": "^19.2.0", "@types/react-dom": "^19.2.0", "@vitejs/plugin-react": "^5.0.0", "typescript": "~5.9.3", "vite": "^7.2.0" }
}
